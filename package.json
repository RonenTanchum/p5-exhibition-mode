{
  "name": "p5-exhibition-mode",
  "version": "0.1.0",
  "description": "Gallery-ready runtime controls for p5.js artworks.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./sensors": {
      "types": "./src/index.d.ts",
      "import": "./src/sensors.js"
    }
  },
  "files": [
    "src",
    "schemas",
    "templates",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/sensors.js",
    "demo": "python3 -m http.server 4177"
  },
  "keywords": [
    "p5",
    "p5js",
    "generative-art",
    "exhibition",
    "kiosk",
    "gallery",
    "museum",
    "creative-coding"
  ],
  "author": "Phenomena Labs",
  "license": "MIT"
}
